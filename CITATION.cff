cff-version: 1.2.0
message: |
  Cite this repository for the Windows editor. Cite Andrea Volpato’s
  spektrafilm for the spectral model and measured colour profiles.
title: "SpektrafilmWinApp"
abstract: |
  An independently maintained Windows darkroom derived from SpektraLab.
  The Qt Quick editor develops photographs with a native Vulkan renderer,
  spectral film and paper models, and colour-managed print previews.
authors:
  - name: "SpektrafilmWinApp contributors"
license: "GPL-3.0-or-later"
repository-code: "https://github.com/wuye9036/SpektraLab"
keywords:
  - "film simulation"
  - "spectral imaging"
  - "Windows"
  - "Vulkan"

references:
  - type: "software"
    title: "SpektraLab"
    authors:
      - family-names: "Qiu"
        given-names: "Hanze"
    repository-code: "https://github.com/JamesQiu2005/SpektraLab"
  - type: "software"
    title: "spektrafilm: spectral simulation of analog photography"
    abstract: |
      The spectral film and print simulation SpektraLab renders. Source of the
      28 film and paper profiles, the characteristic curves, the DIR-coupler
      and halation models, and the RA-4 print and scan chain.
    authors:
      - family-names: "Volpato"
        given-names: "Andrea"
        orcid: "https://orcid.org/0000-0003-3368-0017"
        affiliation: "KTH Royal Institute of Technology, Sweden"
    repository-code: "https://github.com/andreavolpato/spektrafilm"
    url: "https://github.com/andreavolpato/spektrafilm"
    license: "GPL-3.0-or-later"
    year: 2025
