#version 450
#extension GL_GOOGLE_include_directive : require
#include "display_half.glsl"
layout(local_size_x=16, local_size_y=16) in;
layout(set=0, binding=0, std430) readonly buffer Print { float rgb[]; };
// A display-only caller binds one dummy word. The editor retains exact
// 16-bit codes for export without reading the RGB plane a second time.
layout(set=0, binding=1, std430) writeonly buffer Exact { uint words[]; };
layout(set=0, binding=2, rgba16f) uniform writeonly image2D frame;
void main() {
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(frame);
    if (any(greaterThanEqual(xy, size))) return;
    uint i = 3u * uint(xy.y * size.x + xy.x);
    vec3 code = floor(clamp(vec3(rgb[i], rgb[i+1], rgb[i+2]), 0.0, 1.0) * 65535.0 + 0.5);
    uint pixel = uint(xy.y * size.x + xy.x);
    if (pixel < uint(words.length()) / 2u) {
        uvec3 c = uvec3(code);
        words[2u*pixel] = c.r | (c.g << 16u);
        words[2u*pixel+1u] = c.b | 0xffff0000u;
    }
    imageStore(frame, xy, displayHalf(code));
}
